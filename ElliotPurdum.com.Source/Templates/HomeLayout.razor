@inherits BasePageLayout

<Header NavLinks="NavLinks"></Header>
<main class="page-content" aria-label="content">
    <section class="hero">
        <div class="wrapper hero__inner">
            @if (SubTitle is not null)
            {
                <p class="hero__eyebrow">@SubTitle</p>
            }
            <h1 class="hero__name">@Title</h1>
            <div class="hero__lede">
                @Content
            </div>
            @if (!string.IsNullOrWhiteSpace(HeroImage))
            {
                <figure class="hero__figure">
                    <img src="@HeroImage" alt="@(HeroImageAlt ?? string.Empty)" loading="eager" />
                </figure>
            }
        </div>
    </section>

    <section class="home-section home-section--shows">
        <div class="wrapper">
            <div class="section-heading">
                <h2 class="section-title">Upcoming</h2>
                <a class="section-link" href="/shows.html">All shows &rarr;</a>
            </div>
            @{
                DateTime today = DateTime.Today;
                var upcoming = (ShowEntries ?? [])
                    .Where(s => s.PerformanceDate >= today)
                    .OrderBy(s => s.PerformanceDate)
                    .Take(3)
                    .ToList();
            }
            @if (upcoming.Count == 0)
            {
                <p class="empty-note">Nothing announced just now &mdash; check back soon.</p>
            }
            else
            {
                <ul class="show-list">
                    @foreach (ShowMetaData show in upcoming)
                    {
                        <li class="show-list__item">
                            <time class="show-list__date" datetime="@show.PerformanceDate.ToString("yyyy-MM-dd")">
                                <span class="show-list__month">@show.PerformanceDate.ToString("MMM")</span>
                                <span class="show-list__day">@show.PerformanceDate.Day</span>
                                <span class="show-list__year">@show.PerformanceDate.Year</span>
                            </time>
                            <div class="show-list__body">
                                <h3 class="show-list__title"><a href="@(show.Url).html">@show.Title</a></h3>
                                @if (show.ExtraParameters.GetValueOrDefault("Venue") is string v && !string.IsNullOrWhiteSpace(v))
                                {
                                    <p class="show-list__venue">@v@(show.ExtraParameters.GetValueOrDefault("City") is string city && !string.IsNullOrWhiteSpace(city) ? $", {city}" : "")</p>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>

    <section class="home-section home-section--music">
        <div class="wrapper">
            <div class="section-heading">
                <h2 class="section-title">Recent music</h2>
                <a class="section-link" href="/music.html">All music &rarr;</a>
            </div>
            @{
                var featured = (MusicEntries ?? [])
                    .OrderByDescending(m => m.Date)
                    .Take(3)
                    .ToList();
            }
            @if (featured.Count == 0)
            {
                <p class="empty-note">Recordings coming soon.</p>
            }
            else
            {
                <ul class="music-list">
                    @foreach (MusicMetaData music in featured)
                    {
                        <li class="music-list__item">
                            <a class="music-card" href="@(music.Url).html">
                                @if (music.ExtraParameters.GetValueOrDefault("CoverImage") is string cover && !string.IsNullOrWhiteSpace(cover))
                                {
                                    <img class="music-card__cover" src="@cover" alt="" loading="lazy" />
                                }
                                <h3 class="music-card__title">@music.Title</h3>
                                @if (music.ExtraParameters.GetValueOrDefault("Ensemble") is string ensemble && !string.IsNullOrWhiteSpace(ensemble))
                                {
                                    <p class="music-card__ensemble">@ensemble</p>
                                }
                                <p class="music-card__date">@music.Date.ToString("MMMM yyyy")</p>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>

    <section class="home-section home-section--writing">
        <div class="wrapper">
            <div class="section-heading">
                <h2 class="section-title">Writing</h2>
                <a class="section-link" href="/blog.html">All posts &rarr;</a>
            </div>
            @{
                var recentPosts = NavLinks.OrderByDescending(p => p.PublishedDate).Take(3).ToList();
            }
            @if (recentPosts.Count == 0)
            {
                <p class="empty-note">Nothing here yet.</p>
            }
            else
            {
                <ul class="post-list">
                    @foreach (LinkData link in recentPosts)
                    {
                        <li class="post-list__item">
                            <time class="post-list__date" datetime="@link.PublishedDate.ToString("yyyy-MM-dd")">@link.PublishedDate.ToString("MMM d, yyyy")</time>
                            <h3 class="post-list__title"><a href="@(link.Url).html">@link.Title</a></h3>
                            @if (!string.IsNullOrWhiteSpace(link.SubTitle))
                            {
                                <p class="post-list__subtitle">@link.SubTitle</p>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </section>
</main>
<Footer></Footer>

@code {
    [Parameter] public List<MusicMetaData>? MusicEntries { get; set; }
    [Parameter] public List<ShowMetaData>? ShowEntries { get; set; }
    [Parameter] public List<GalleryMetaData>? GalleryEntries { get; set; }

    // Frontmatter-driven via BlogGenerator's PascalCased ExtraFrontMatter forwarding.
    [Parameter] public string? HeroImage { get; set; }
    [Parameter] public string? HeroImageAlt { get; set; }
}
