@inject GitHubApiService Api
@inject NavigationManager Nav

<header class="page-heading">
    <div class="page-heading__row">
        <h1>@Title</h1>
        <a class="admin-button" href="/admin/@TypeSlug/new">New @SingularNoun</a>
    </div>
    <p class="page-heading__lede">@Lede</p>
</header>

@if (_loading)
{
    <p class="empty">Loading…</p>
}
else if (_error is not null)
{
    <div class="alert alert--error" role="alert">
        <p><strong>Couldn't load entries.</strong> @_error</p>
        <button class="admin-button admin-button--ghost" @onclick="LoadAsync">Try again</button>
    </div>
}
else if (_rows.Count == 0)
{
    <div class="alert">
        <p>No entries yet.</p>
        <a class="admin-button" href="/admin/@TypeSlug/new">Create the first one</a>
    </div>
}
else
{
    <table class="content-table">
        <thead>
            <tr>
                <th class="content-table__date">Date</th>
                <th class="content-table__slug">Slug</th>
                <th class="content-table__actions"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Row row in _rows)
            {
                <tr class="content-table__row">
                    <td class="content-table__date">
                        <time datetime="@row.Date.ToString("yyyy-MM-dd")">@row.Date.ToString(DateFormat)</time>
                    </td>
                    <td class="content-table__slug">
                        <a class="content-table__title" href="/admin/@TypeSlug/edit/@Uri.EscapeDataString(row.FileName)">@row.Slug</a>
                    </td>
                    <td class="content-table__actions">
                        @if (_pendingDelete == row.FileName)
                        {
                            <span class="confirm-row">
                                <span class="confirm-row__prompt">Delete?</span>
                                <button class="admin-button admin-button--small admin-button--danger" @onclick="() => ConfirmDeleteAsync(row)" disabled="@_busy">Yes, delete</button>
                                <button class="admin-button admin-button--small admin-button--ghost" @onclick="CancelDelete" disabled="@_busy">Cancel</button>
                            </span>
                        }
                        else
                        {
                            <a class="admin-button admin-button--small admin-button--ghost" href="/admin/@TypeSlug/edit/@Uri.EscapeDataString(row.FileName)">Edit</a>
                            <button class="admin-button admin-button--small admin-button--ghost" @onclick="() => RequestDelete(row)">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="content-table__count">@_rows.Count entries</p>
}

@code {
    [Parameter] public required string Title { get; set; }
    [Parameter] public required string Lede { get; set; }
    [Parameter] public required string ContentPath { get; set; }
    [Parameter] public required ContentNamePattern Pattern { get; set; }
    [Parameter] public required string TypeSlug { get; set; }
    [Parameter] public required string SingularNoun { get; set; }

    private bool _loading = true;
    private string? _error;
    private List<Row> _rows = [];
    private string? _pendingDelete;
    private bool _busy;

    private string DateFormat => Pattern == ContentNamePattern.YearMonth ? "MMM yyyy" : "MMM d, yyyy";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            IReadOnlyList<RepoEntry> entries = await Api.ListDirectoryAsync(ContentPath);
            _rows = entries
                .Where(e => e.Type == "file" && e.Name.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
                .Select(ParseRow)
                .Where(r => r is not null)
                .Select(r => r!)
                .OrderByDescending(r => r.Date)
                .ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Row? ParseRow(RepoEntry entry)
    {
        // Filenames: YYYY-MM-DD-slug.md (posts/music/shows) or YYYY-MM-slug.md (gallery).
        string baseName = entry.Name;
        if (baseName.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
        {
            baseName = baseName[..^3];
        }

        string[] parts = baseName.Split('-', Pattern == ContentNamePattern.YearMonth ? 3 : 4);
        int requiredParts = Pattern == ContentNamePattern.YearMonth ? 3 : 4;
        if (parts.Length < requiredParts) return null;

        if (!int.TryParse(parts[0], out int year) ||
            !int.TryParse(parts[1], out int month))
        {
            return null;
        }

        DateTime date;
        string slug;
        if (Pattern == ContentNamePattern.YearMonth)
        {
            date = new DateTime(year, month, 1);
            slug = parts[2];
        }
        else
        {
            if (!int.TryParse(parts[2], out int day)) return null;
            date = new DateTime(year, month, day);
            slug = parts[3];
        }

        return new Row(entry.Name, entry.Sha, entry.Path, slug, date);
    }

    private void RequestDelete(Row row) => _pendingDelete = row.FileName;
    private void CancelDelete() => _pendingDelete = null;

    private async Task ConfirmDeleteAsync(Row row)
    {
        _busy = true;
        try
        {
            await Api.DeleteFileAsync(row.Path, row.Sha,
                commitMessage: $"admin: delete {TypeSlug} entry {row.Slug}");
            _rows.Remove(row);
            _pendingDelete = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed record Row(string FileName, string Sha, string Path, string Slug, DateTime Date);
}
