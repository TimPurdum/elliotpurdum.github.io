@page "/{TypeSlug}/new"
@page "/{TypeSlug}/edit/{File}"
@inject GitHubApiService Api
@inject NavigationManager Nav
@inject DeployStatusService Deploy

<PageTitle>@PageTitleText — admin</PageTitle>

<header class="page-heading">
    <div class="page-heading__row">
        <h1>@PageTitleText</h1>
        <a class="admin-button admin-button--ghost" href="/admin/@TypeSlug">&larr; Back to @TypeSlug</a>
    </div>
    @if (!string.IsNullOrEmpty(File))
    {
        <p class="page-heading__lede">Editing <code class="path">@File</code></p>
    }
</header>

@if (_kind is null)
{
    <div class="alert alert--error" role="alert">
        <p><strong>Unknown content type.</strong> <code>@TypeSlug</code> is not one of <code>posts</code>, <code>music</code>, <code>shows</code>, or <code>gallery</code>.</p>
    </div>
}
else if (_loading)
{
    <p class="empty">Loading…</p>
}
else if (_error is not null)
{
    <div class="alert alert--error" role="alert">
        <p><strong>Couldn't load file.</strong> @_error</p>
    </div>
}
else
{
    <form class="editor" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
        @* File-naming inputs. On /new these are blank; on edit they're pre-filled from the existing
           filename so the user can change date + slug to rename in place. *@
        <fieldset class="editor-fieldset">
            <legend class="editor-fieldset__legend">File</legend>
            <div class="form-grid">
                @if (_kind != ContentKind.Page)
                {
                    <FormRow Label="Date" Required="true" For="entry-date"
                             Hint="@(_kind == ContentKind.Gallery ? "Approximate month — used for sort order." : (_kind == ContentKind.Show ? "Performance date — embedded in the URL." : "Date used in the filename and (for posts) in the URL."))">
                        @if (_kind == ContentKind.Gallery)
                        {
                            <input id="entry-date" class="form-input" type="month" required
                                   value="@_dateMonth"
                                   @oninput="@(e => _dateMonth = e.Value?.ToString() ?? "")" />
                        }
                        else
                        {
                            <input id="entry-date" class="form-input" type="date" required
                                   value="@_dateFull"
                                   @oninput="@(e => _dateFull = e.Value?.ToString() ?? "")" />
                        }
                    </FormRow>
                }
                <FormRow Label="Slug" Required="true" For="entry-slug"
                         Hint="@SlugHint">
                    <input id="entry-slug" class="form-input" type="text" required
                           value="@_slug"
                           @oninput="@(e => _slug = e.Value?.ToString() ?? "")"
                           pattern="[a-z0-9][a-z0-9\-]*"
                           placeholder="@(_kind == ContentKind.Page ? "about" : "my-new-entry")"
                           disabled="@(_kind == ContentKind.Page && _slugIsLocked)" />
                </FormRow>
            </div>
            @if (!string.IsNullOrEmpty(File) && WillRename)
            {
                <p class="form-row__hint" style="margin-top: 0.5rem;">
                    Saving will rename: <code class="path">@OriginalFileName</code> &rarr; <code class="path">@BuildNewFileName()</code>.
                    The old URL stops working after the next deploy — there is no redirect.
                </p>
            }
        </fieldset>

        <fieldset class="editor-fieldset">
            <legend class="editor-fieldset__legend">Frontmatter</legend>
            @switch (_kind)
            {
                case ContentKind.Post:    <PostEditorForm    Frontmatter="_postFront"    /> ; break;
                case ContentKind.Music:   <MusicEditorForm   Frontmatter="_musicFront"   /> ; break;
                case ContentKind.Show:    <ShowEditorForm    Frontmatter="_showFront"    /> ; break;
                case ContentKind.Gallery: <GalleryEditorForm Frontmatter="_galleryFront" /> ; break;
                case ContentKind.Page:    <PageEditorForm    Frontmatter="_pageFront"    /> ; break;
            }
        </fieldset>

        <fieldset class="editor-fieldset">
            <legend class="editor-fieldset__legend">@BodyLegend</legend>
            @if (_kind == ContentKind.Gallery)
            {
                <p class="form-row__hint">Optional prose shown below the photo grid.</p>
            }
            else if (_kind == ContentKind.Page && _pageFront.Layout == "home")
            {
                <p class="form-row__hint">Lede paragraph(s) shown under the hero name. Plain markdown — no need to repeat the title or eyebrow.</p>
            }
            <MarkdownEditor Value="@_body" ValueChanged="@(v => _body = v)" Height="@(_kind == ContentKind.Gallery ? "18rem" : "32rem")" />
        </fieldset>

        @if (_saveError is not null)
        {
            <div class="alert alert--error" role="alert">
                <p><strong>Save failed.</strong> @_saveError</p>
            </div>
        }

        <div class="editor-actions">
            <button class="admin-button" type="submit" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
            <a class="admin-button admin-button--ghost" href="/admin/@TypeSlug">Cancel</a>
        </div>
    </form>
}

@code {
    [Parameter] public string? TypeSlug { get; set; }
    [Parameter] public string? File { get; set; }

    private ContentKind? _kind;
    private bool _loading = true;
    private string? _error;

    private bool _saving;
    private string? _saveError;

    // Frontmatter state — only one is populated per request, based on _kind.
    private PostFrontMatter _postFront = new();
    private MusicFrontMatter _musicFront = new();
    private ShowFrontMatter _showFront = new();
    private GalleryFrontMatter _galleryFront = new();
    private PageFrontMatter _pageFront = new();

    private string _body = "";
    private string? _existingSha;     // null on /new

    // Filename inputs. On /new these start fresh; on edit they're pre-filled from the existing filename.
    private string _dateFull = DateTime.Today.ToString("yyyy-MM-dd");   // YYYY-MM-DD for posts/music/shows
    private string _dateMonth = DateTime.Today.ToString("yyyy-MM");      // YYYY-MM for gallery
    private string _slug = "";

    /// <summary>The filename loaded from disk on edit — used to detect rename intent on Save.</summary>
    private string OriginalFileName => string.IsNullOrEmpty(File) ? "" : Uri.UnescapeDataString(File);

    /// <summary>True when the user changed date or slug on an existing entry, so Save needs to PUT+DELETE.
    /// Returns false while the slug input is empty (BuildNewFileName would throw); the form's `required`
    /// attribute on the slug field blocks submission in that state anyway.</summary>
    private bool WillRename
    {
        get
        {
            if (string.IsNullOrEmpty(File)) return false;
            if (string.IsNullOrWhiteSpace(_slug)) return false;
            return !string.Equals(BuildNewFileName(), OriginalFileName, StringComparison.OrdinalIgnoreCase);
        }
    }

    /// <summary>The home page can't be renamed — its URL is hardcoded into NavMenu and the Blazor router.</summary>
    private bool _slugIsLocked;

    private string SlugHint => _kind switch
    {
        ContentKind.Page when _slugIsLocked
            => "The home page slug is locked — `index` renders at /, and renaming it would break navigation.",
        ContentKind.Page
            => "Becomes the filename and URL — e.g. 'about' renders at /about.html.",
        _   => "lowercase-with-hyphens. Becomes the filename and (for music/gallery) the URL."
    };

    private string PageTitleText =>
        string.IsNullOrEmpty(File)
            ? $"New {SingularNoun(_kind)}"
            : $"Edit {SingularNoun(_kind)}";

    private string BodyLegend => _kind switch
    {
        ContentKind.Gallery => "Notes",
        ContentKind.Page when _pageFront.Layout == "home" => "Hero lede",
        _ => "Body"
    };

    protected override async Task OnParametersSetAsync()
    {
        _kind = TypeSlug switch
        {
            "posts"   => ContentKind.Post,
            "music"   => ContentKind.Music,
            "shows"   => ContentKind.Show,
            "gallery" => ContentKind.Gallery,
            "pages"   => ContentKind.Page,
            _ => null
        };
        if (_kind is null) { _loading = false; return; }

        if (string.IsNullOrEmpty(File))
        {
            _loading = false;
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            string decoded = Uri.UnescapeDataString(File);
            string path = $"{ContentDirectory(_kind.Value)}/{decoded}";
            RepoFile? repoFile = await Api.GetFileAsync(path);
            if (repoFile is null)
            {
                _error = $"File '{decoded}' not found in {ContentDirectory(_kind.Value)}.";
                return;
            }
            _existingSha = repoFile.Sha;
            ParseFromText(repoFile.Text);
            PrefillFilenameInputs(decoded);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Populate the File fieldset (date + slug) from the existing filename so the user can edit
    /// either piece to rename. Mirrors the format BuildNewFileName produces.</summary>
    private void PrefillFilenameInputs(string fileName)
    {
        string baseName = StripExtension(fileName);
        switch (_kind)
        {
            case ContentKind.Gallery when TryParseYearMonth(baseName, out int y, out int m, out string slug):
                _dateMonth = $"{y:D4}-{m:D2}";
                _slug = slug;
                break;
            case ContentKind.Post or ContentKind.Music or ContentKind.Show
                when TryParseDated(baseName, out int y, out int m, out int d, out string slug):
                _dateFull = $"{y:D4}-{m:D2}-{d:D2}";
                _slug = slug;
                break;
            case ContentKind.Page:
                _slug = baseName;
                _slugIsLocked = string.Equals(baseName, "index", StringComparison.OrdinalIgnoreCase);
                break;
            default:
                // Fallback for files that don't match the expected naming pattern — leave the
                // slug box editable so the user can correct it.
                _slug = baseName;
                break;
        }
    }

    private void ParseFromText(string text)
    {
        switch (_kind)
        {
            case ContentKind.Post:
                (_postFront, _body) = MarkdownDocument.Parse<PostFrontMatter>(text);
                break;
            case ContentKind.Music:
                (_musicFront, _body) = MarkdownDocument.Parse<MusicFrontMatter>(text);
                break;
            case ContentKind.Show:
                (_showFront, _body) = MarkdownDocument.Parse<ShowFrontMatter>(text);
                break;
            case ContentKind.Gallery:
                (_galleryFront, _body) = MarkdownDocument.Parse<GalleryFrontMatter>(text);
                break;
            case ContentKind.Page:
                (_pageFront, _body) = MarkdownDocument.Parse<PageFrontMatter>(text);
                break;
        }
    }

    private async Task SaveAsync()
    {
        if (_kind is null) return;
        _saving = true;
        _saveError = null;
        try
        {
            // Stamp lastmodified so BlogGenerator's regen heuristic notices the edit.
            string nowStamp = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss");
            string fileText = _kind switch
            {
                ContentKind.Post    => StampAndBuild(_postFront,    pf => pf.Lastmodified = nowStamp),
                ContentKind.Music   => StampAndBuild(_musicFront,   mf => mf.Lastmodified = nowStamp),
                ContentKind.Show    => StampAndBuild(_showFront,    sf => sf.Lastmodified = nowStamp),
                ContentKind.Gallery => StampAndBuild(_galleryFront, gf => gf.Lastmodified = nowStamp),
                ContentKind.Page    => StampAndBuild(_pageFront,    pf => pf.Lastmodified = nowStamp),
                _ => throw new InvalidOperationException()
            };

            bool isNew = string.IsNullOrEmpty(File);
            string newFileName = BuildNewFileName();
            string newPath = $"{ContentDirectory(_kind.Value)}/{newFileName}";

            RepoCommitResult result;
            string? viewLive = BuildViewLiveUrl(_kind.Value, newFileName);

            if (isNew)
            {
                string commitMessage = $"admin: create {TypeSlug} entry {StripExtension(newFileName)}";
                result = await Api.PutTextFileAsync(newPath, fileText, commitMessage);
            }
            else if (WillRename)
            {
                // Two-phase rename: write content at the new path (no sha, since it's a new file there),
                // then delete the old path using its existing sha. Each step is its own commit — GitHub's
                // Contents API has no atomic rename. If the DELETE fails after the PUT succeeds, content
                // sits at both paths and the user will see the rename only partially applied. We surface
                // the error; the user can re-Save to retry the delete.
                string oldPath = $"{ContentDirectory(_kind.Value)}/{OriginalFileName}";
                string slugForCommit = StripExtension(newFileName);
                string putMessage = $"admin: rename {TypeSlug} entry to {slugForCommit}";
                result = await Api.PutTextFileAsync(newPath, fileText, putMessage);

                string deleteMessage = $"admin: delete {TypeSlug} entry {StripExtension(OriginalFileName)} (renamed to {slugForCommit})";
                await Api.DeleteFileAsync(oldPath, _existingSha!, deleteMessage);
            }
            else
            {
                string commitMessage = $"admin: update {TypeSlug} entry {StripExtension(newFileName)}";
                result = await Api.PutTextFileAsync(newPath, fileText, commitMessage, _existingSha);
            }

            // Track the deploy so the user sees a banner update as the commit moves through CI.
            if (!string.IsNullOrEmpty(result.CommitSha))
            {
                Deploy.Track(result.CommitSha, viewLive);
            }

            Nav.NavigateTo($"/admin/{TypeSlug}");
        }
        catch (Exception ex)
        {
            _saveError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private string BuildNewFileName()
    {
        if (string.IsNullOrWhiteSpace(_slug)) throw new InvalidOperationException("Slug is required.");
        string slug = _slug.Trim().ToLowerInvariant();
        return _kind switch
        {
            ContentKind.Gallery => $"{_dateMonth}-{slug}.md",
            ContentKind.Page    => $"{slug}.md",
            _                   => $"{_dateFull}-{slug}.md"
        };
    }

    private static string ContentDirectory(ContentKind kind) => kind switch
    {
        ContentKind.Post    => "ElliotPurdum.com.Source/Content/Posts",
        ContentKind.Music   => "ElliotPurdum.com.Source/Content/Music",
        ContentKind.Show    => "ElliotPurdum.com.Source/Content/Shows",
        ContentKind.Gallery => "ElliotPurdum.com.Source/Content/Gallery",
        ContentKind.Page    => "ElliotPurdum.com.Source/Content/Pages",
        _ => throw new InvalidOperationException()
    };

    /// <summary>Reverse the BlogGenerator's URL convention so we can deep-link the user to their just-saved entry.</summary>
    private static string? BuildViewLiveUrl(ContentKind kind, string fileName)
    {
        string baseName = fileName.EndsWith(".md", StringComparison.OrdinalIgnoreCase) ? fileName[..^3] : fileName;
        return kind switch
        {
            ContentKind.Post when TryParseDated(baseName, out int y, out int m, out int d, out string slug)
                => $"/post/{y}/{m}/{d}/{slug}.html",
            ContentKind.Show when TryParseDated(baseName, out int y, out int m, out int d, out string slug)
                => $"/show/{y}/{m}/{d}/{slug}.html",
            ContentKind.Music when TryParseDated(baseName, out _, out _, out _, out string slug)
                => $"/music/{slug}.html",
            ContentKind.Gallery when TryParseYearMonth(baseName, out _, out _, out string slug)
                => $"/gallery/{slug}.html",
            ContentKind.Page
                => baseName == "index" ? "/" : $"/{baseName}.html",
            _ => null
        };
    }

    private static bool TryParseDated(string baseName, out int year, out int month, out int day, out string slug)
    {
        year = month = day = 0; slug = "";
        string[] parts = baseName.Split('-', 4);
        if (parts.Length < 4) return false;
        if (!int.TryParse(parts[0], out year) ||
            !int.TryParse(parts[1], out month) ||
            !int.TryParse(parts[2], out day)) return false;
        slug = parts[3];
        return true;
    }

    private static bool TryParseYearMonth(string baseName, out int year, out int month, out string slug)
    {
        year = month = 0; slug = "";
        string[] parts = baseName.Split('-', 3);
        if (parts.Length < 3) return false;
        if (!int.TryParse(parts[0], out year) ||
            !int.TryParse(parts[1], out month)) return false;
        slug = parts[2];
        return true;
    }

    private string StampAndBuild<TFront>(TFront fm, Action<TFront> stamp) where TFront : new()
    {
        stamp(fm);
        return MarkdownDocument.Build(fm, _body);
    }

    private static string StripExtension(string fileName) =>
        fileName.EndsWith(".md", StringComparison.OrdinalIgnoreCase) ? fileName[..^3] : fileName;

    private static string SingularNoun(ContentKind? kind) => kind switch
    {
        ContentKind.Post    => "post",
        ContentKind.Music   => "music entry",
        ContentKind.Show    => "show",
        ContentKind.Gallery => "gallery",
        ContentKind.Page    => "page",
        _ => "entry"
    };

    public enum ContentKind { Post, Music, Show, Gallery, Page }
}
